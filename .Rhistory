# 1. Create a mini dataset of cool places
my_roadtrip <- tibble(
place = c("Eiffel Tower", "Colosseum", "Statue of Liberty"),
lon = c(2.294, 12.492, -74.044),
lat = c(48.858, 41.890, 40.689)
)
library(tibble) # For making a quick dataframe
# 1. Create a mini dataset of cool places
my_roadtrip <- tibble(
place = c("Eiffel Tower", "Colosseum", "Statue of Liberty"),
lon = c(2.294, 12.492, -74.044),
lat = c(48.858, 41.890, 40.689)
)
# 2. Map the whole dataset at once!
leaflet(data = my_roadtrip) |>
