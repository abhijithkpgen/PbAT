# Load required libraries
library(tidyverse)
# 1. Import TASSEL LD output file
ld <- read.delim(file.choose(), stringsAsFactors = FALSE, header = TRUE, sep = "\t")
# 2. Clean and filter the data
# Removes NaN, N/A, forces numeric types, and filters by pDiseq
ld_clean <- ld %>%
filter(R.2 != "NaN", Dist_bp != "N/A") %>%
mutate(
dist = as.numeric(Dist_bp),
rsq = as.numeric(R.2),
pDiseq = as.numeric(pDiseq) # Ensure pDiseq is numeric
) %>%
filter(pDiseq < 0.05)
# 3. Binning the data to calculate means per bin
# Cuts distance into 1kb bins up to 10Mb
ld_binned <- ld_clean %>%
mutate(bin = cut(dist, breaks = seq(1, 10000000, by = 1000), labels = FALSE)) %>%
group_by(bin) %>%
summarise(
mean_dist = mean(dist, na.rm = TRUE),
mean_rsq = mean(rsq, na.rm = TRUE)
) %>%
drop_na() # Removes bins with no data
# 4. Plotting using ggplot2 (LOESS smoothing)
ld_plot <- ggplot(ld_binned, aes(x = mean_dist, y = mean_rsq)) +
geom_point(color = "grey", alpha = 0.7) +
stat_smooth(
method = "loess",
color = "red",
formula = y ~ x,
se = FALSE,
span = 0.5,
method.args = list(degree = 2)
) +
scale_x_continuous(
name = "Distance (bp)",
limits = c(0, 5.0e+06),
breaks = seq(0, 5.0e+06, 500000),
expand = c(0, 0)
) +
scale_y_continuous(
name = expression(LD ~ (r^2)),
limits = c(0, 0.8),
breaks = seq(0.0, 0.8, 0.1),
expand = c(0, 0)
) +
theme_bw() + # A cleaner base theme
theme(
panel.background = element_rect(fill = "white", colour = "white"),
# Note: 'linewidth' is the updated argument for line thickness in newer ggplot2 versions
panel.grid.major = element_line(linewidth = 0.5, linetype = 'solid', colour = "lightblue"),
panel.grid.minor = element_blank(),
axis.line = element_line(linewidth = 0.5, linetype = "solid", colour = "black")
)
# Display the plot
print(ld_plot)
